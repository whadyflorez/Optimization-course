      "source": [
        "import sys\n",
        "\n",
        "\n",
        "# =====================================================================\n",
        "# EJERCICIO 1 - Efecto de step_size y T en Basin Hopping\n",
        "# =====================================================================\n",
        "def ejercicio_1():\n",
        "    import numpy as np\n",
        "    from scipy.optimize import minimize\n",
        "\n",
        "    POZOS = [\n",
        "        (-5.0, -6.5, 4.0, 1.3),\n",
        "        (-4.0,  5.0, 4.0, 1.1),\n",
        "        (-3.0, -5.0, -4.0, 1.1),\n",
        "        (-2.0,  5.0, -5.0, 1.0),\n",
        "        (-1.8,  0.0, 6.0, 1.0),\n",
        "        (-1.5, -6.0, 0.0, 1.0),\n",
        "    ]\n",
        "\n",
        "    def f(x, y):\n",
        "        z = 0.03 * (x**2 + y**2)\n",
        "        for w, cx, cy, s in POZOS:\n",
        "            z += w * np.exp(-((x - cx)**2 + (y - cy)**2) / (2 * s**2))\n",
        "        return z\n",
        "\n",
        "    def local_search_bfgs(x0):\n",
        "        res = minimize(lambda p: f(p[0], p[1]), x0, method=\"BFGS\")\n",
        "        return res.x, float(res.fun)\n",
        "\n",
        "    def basin_hopping_manual_fast(x0, n_iter=40, step_size=7.0, T=1.5, seed=0):\n",
        "        rng = np.random.default_rng(seed)\n",
        "        x_cur, f_cur = local_search_bfgs(x0)\n",
        "        x_best, f_best = np.array(x_cur), f_cur\n",
        "        for it in range(1, n_iter + 1):\n",
        "            x_prop = x_cur + rng.uniform(-step_size, step_size, size=2)\n",
        "            x_new, f_new = local_search_bfgs(x_prop)\n",
        "            if f_new < f_cur:\n",
        "                aceptado = True\n",
        "            else:\n",
        "                aceptado = rng.random() < np.exp(-(f_new - f_cur) / T)\n",
        "            if aceptado:\n",
        "                x_cur, f_cur = x_new, f_new\n",
        "                if f_new < f_best:\n",
        "                    x_best, f_best = np.array(x_new), f_new\n",
        "        return np.array(x_best), f_best\n",
        "\n",
        "    # --- Verificacion: la implementacion reproduce el resultado de la Clase 3 ---\n",
        "    x0 = np.array([8.0, -8.0])\n",
        "    xb, fb = basin_hopping_manual_fast(x0, n_iter=40, step_size=7.0, T=1.5, seed=0)\n",
        "    print(xb, fb)\n",
        "\n",
        "    # --- Barrido de experimentos ---\n",
        "    f_global = -3.2879983559811907\n",
        "    tol_exito = 0.01  # \"exito\" si f_best esta a menos de 0.01 del global\n",
        "\n",
        "    step_sizes = [2, 5, 10, 15]\n",
        "    temperaturas = [0.3, 1.5, 5]\n",
        "    seeds = list(range(10))\n",
        "\n",
        "    resultados = {}\n",
        "    for step in step_sizes:\n",
        "        for T in temperaturas:\n",
        "            exitos = 0\n",
        "            f_vals = []\n",
        "            for seed in seeds:\n",
        "                xb, fb = basin_hopping_manual_fast(x0, n_iter=40, step_size=step, T=T, seed=seed)\n",
        "                f_vals.append(fb)\n",
        "                if abs(fb - f_global) < tol_exito:\n",
        "                    exitos += 1\n",
        "            resultados[(step, T)] = (exitos, np.mean(f_vals), np.min(f_vals), np.max(f_vals))\n",
        "\n",
        "    # --- Tabla de resultados ---\n",
        "    print(\"### 4. Resultados obtenidos (10 corridas por combinacion)\\n\")\n",
        "\n",
        "    header = (f\"{'step_size':>10} | {'T':>5} | {'Exitos / 10':>11} | \"\n",
        "              f\"{'f promedio':>12} | {'f minimo':>10} | {'f maximo':>10}\")\n",
        "    print(header)\n",
        "    print(\"-\" * len(header))\n",
        "\n",
        "    for (step, T), (exitos, f_mean, f_min, f_max) in resultados.items():\n",
        "        print(f\"{step:10d} | {T:5.1f} | {exitos:11d} | {f_mean:12.4f} | \"\n",
        "              f\"{f_min:10.4f} | {f_max:10.4f}\")\n",
        "\n",
        "\n",
        "# =====================================================================\n",
        "# EJERCICIO 2 - Enfriamiento lineal vs. geometrico en Simulated Annealing\n",
        "# =====================================================================\n",
        "def ejercicio_2():\n",
        "    import numpy as np\n",
        "\n",
        "    POZOS = [\n",
        "        (-5.0, -6.5, 4.0, 1.3),\n",
        "        (-4.0,  5.0, 4.0, 1.1),\n",
        "        (-3.0, -5.0, -4.0, 1.1),\n",
        "        (-2.0,  5.0, -5.0, 1.0),\n",
        "        (-1.8,  0.0, 6.0, 1.0),\n",
        "        (-1.5, -6.0, 0.0, 1.0),\n",
        "    ]\n",
        "\n",
        "    def f(x, y):\n",
        "        z = 0.03 * (x**2 + y**2)\n",
        "        for w, cx, cy, s in POZOS:\n",
        "            z += w * np.exp(-((x - cx)**2 + (y - cy)**2) / (2 * s**2))\n",
        "        return z\n",
        "\n",
        "    def simulated_annealing_geometrico(x0, T0=8.0, alpha=0.96, n_iter=200, paso=1.5, seed=0):\n",
        "        rng = np.random.default_rng(seed)\n",
        "        x_cur = np.array(x0, dtype=float)\n",
        "        f_cur = float(f(*x_cur))\n",
        "        x_best, f_best = x_cur.copy(), f_cur\n",
        "        historia, T_historia = [x_cur.copy()], []\n",
        "        T = T0\n",
        "        for it in range(n_iter):\n",
        "            x_prop = x_cur + rng.normal(scale=paso, size=2)\n",
        "            f_prop = float(f(*x_prop))\n",
        "            dE = f_prop - f_cur\n",
        "            aceptado = dE < 0 or rng.random() < np.exp(-dE / T)\n",
        "            if aceptado:\n",
        "                x_cur, f_cur = x_prop, f_prop\n",
        "                if f_cur < f_best:\n",
        "                    x_best, f_best = x_cur.copy(), f_cur\n",
        "            historia.append(x_cur.copy())\n",
        "            T_historia.append(T)\n",
        "            T *= alpha            # <-- ENFRIAMIENTO GEOMETRICO\n",
        "        return x_best, f_best, np.array(historia), np.array(T_historia)\n",
        "\n",
        "    def simulated_annealing_lineal(x0, T0=8.0, n_iter=200, paso=1.5, seed=0):\n",
        "        rng = np.random.default_rng(seed)\n",
        "        x_cur = np.array(x0, dtype=float)\n",
        "        f_cur = float(f(*x_cur))\n",
        "        x_best, f_best = x_cur.copy(), f_cur\n",
        "        historia, T_historia = [x_cur.copy()], []\n",
        "        for k in range(n_iter):\n",
        "            T = T0 * (1 - k / n_iter)     # <-- ENFRIAMIENTO LINEAL\n",
        "            T = max(T, 1e-8)              # evita division por 0 en la ultima iteracion\n",
        "            x_prop = x_cur + rng.normal(scale=paso, size=2)\n",
        "            f_prop = float(f(*x_prop))\n",
        "            dE = f_prop - f_cur\n",
        "            aceptado = dE < 0 or rng.random() < np.exp(-dE / T)\n",
        "            if aceptado:\n",
        "                x_cur, f_cur = x_prop, f_prop\n",
        "                if f_cur < f_best:\n",
        "                    x_best, f_best = x_cur.copy(), f_cur\n",
        "            historia.append(x_cur.copy())\n",
        "            T_historia.append(T)\n",
        "        return x_best, f_best, np.array(historia), np.array(T_historia)\n",
        "\n",
        "    # --- Comparacion con la misma semilla del script original (seed=0) ---\n",
        "    x0 = np.array([8.0, -8.0])\n",
        "\n",
        "    xb_geo, fb_geo, hist_geo, T_geo = simulated_annealing_geometrico(\n",
        "        x0, T0=8.0, alpha=0.96, n_iter=200, paso=1.5, seed=0)\n",
        "    xb_lin, fb_lin, hist_lin, T_lin = simulated_annealing_lineal(\n",
        "        x0, T0=8.0, n_iter=200, paso=1.5, seed=0)\n",
        "\n",
        "    print(f\"Geometrico -> x* = {xb_geo.round(4)} f* = {fb_geo:.4f}    T: {T_geo[0]:.1f} -> {T_geo[-1]:.5f}\")\n",
        "    print(f\"Lineal     -> x* = {xb_lin.round(4)} f* = {fb_lin:.4f}    T: {T_lin[0]:.1f} -> {T_lin[-1]:.5f}\")\n",
        "\n",
        "    # --- Comparacion de las curvas de temperatura ---\n",
        "    # Movimientos aceptados: pasos en que la cadena cambio de posicion\n",
        "    acc_g = int(np.sum(np.any(np.diff(hist_geo, axis=0) != 0, axis=1)))\n",
        "    acc_l = int(np.sum(np.any(np.diff(hist_lin, axis=0) != 0, axis=1)))\n",
        "\n",
        "    T0, alpha, n_iter = 8.0, 0.96, 200\n",
        "    Tg = T0 * alpha ** np.arange(n_iter)\n",
        "    Tl = T0 * (1 - np.arange(n_iter) / n_iter)\n",
        "\n",
        "    metricas = [\n",
        "        (\"T promedio en las primeras 50 iteraciones\", Tg[:50].mean(), Tl[:50].mean()),\n",
        "        (\"T promedio en las ultimas 50 iteraciones\", Tg[-50:].mean(), Tl[-50:].mean()),\n",
        "        (\"T en la iteracion 100 (mitad del proceso)\", Tg[100], Tl[100]),\n",
        "        (\"T final (iteracion 200)\", Tg[-1], Tl[-1]),\n",
        "        (\"Movimientos aceptados (de 200)\", acc_g, acc_l),\n",
        "    ]\n",
        "\n",
        "    header = f\"{'Metrica':45} | {'Geometrico':>12} | {'Lineal':>10}\"\n",
        "    print(header)\n",
        "    print(\"-\" * len(header))\n",
        "    for nombre, vg, vl in metricas:\n",
        "        print(f\"{nombre:45} | {vg:12.4f} | {vl:10.4f}\")\n",
        "\n",
        "    # --- Comparacion de robustez con 10 semillas distintas ---\n",
        "    f_global = -3.2879983559811907\n",
        "    tol_exito = 0.05\n",
        "\n",
        "    seeds = list(range(10))\n",
        "    resultados_geo, resultados_lin = [], []\n",
        "    for seed in seeds:\n",
        "        _, fb_g, _, _ = simulated_annealing_geometrico(x0, T0=8.0, alpha=0.96, n_iter=200, paso=1.5, seed=seed)\n",
        "        _, fb_l, _, _ = simulated_annealing_lineal(x0, T0=8.0, n_iter=200, paso=1.5, seed=seed)\n",
        "        resultados_geo.append(fb_g)\n",
        "        resultados_lin.append(fb_l)\n",
        "\n",
        "    resultados_geo = np.array(resultados_geo)\n",
        "    resultados_lin = np.array(resultados_lin)\n",
        "\n",
        "    exitos_geo = np.sum(np.abs(resultados_geo - f_global) < tol_exito)\n",
        "    exitos_lin = np.sum(np.abs(resultados_lin - f_global) < tol_exito)\n",
        "\n",
        "    header = (f\"{'Metodo':12} | {'Exitos/10':>9} | {'f promedio':>11} | \"\n",
        "              f\"{'f minimo':>10} | {'f maximo':>10}\")\n",
        "    print(header)\n",
        "    print(\"-\" * len(header))\n",
        "    print(f\"{'Geometrico':12} | {exitos_geo:9d} | {resultados_geo.mean():11.4f} | \"\n",
        "          f\"{resultados_geo.min():10.4f} | {resultados_geo.max():10.4f}\")\n",
        "    print(f\"{'Lineal':12} | {exitos_lin:9d} | {resultados_lin.mean():11.4f} | \"\n",
        "          f\"{resultados_lin.min():10.4f} | {resultados_lin.max():10.4f}\")\n",
        "\n",
        "\n",
        "# =====================================================================\n",
        "# EJERCICIO 3 - Efecto del elitismo en el algoritmo genetico\n",
        "# =====================================================================\n",
        "def ejercicio_3():\n",
        "    import numpy as np\n",
        "    import matplotlib\n",
        "    matplotlib.use(\"Agg\")\n",
        "    import matplotlib.pyplot as plt\n",
        "\n",
        "    POZOS = [\n",
        "        (-5.0, -6.5, 4.0, 1.3),\n",
        "        (-4.0,  5.0, 4.0, 1.1),\n",
        "        (-3.0, -5.0, -4.0, 1.1),\n",
        "        (-2.0,  5.0, -5.0, 1.0),\n",
        "        (-1.8,  0.0, 6.0, 1.0),\n",
        "        (-1.5, -6.0, 0.0, 1.0),\n",
        "    ]\n",
        "\n",
        "    def f(x, y):\n",
        "        z = 0.03 * (x**2 + y**2)\n",
        "        for w, cx, cy, s in POZOS:\n",
        "            z += w * np.exp(-((x - cx)**2 + (y - cy)**2) / (2 * s**2))\n",
        "        return z\n",
        "\n",
        "    BOUNDS = np.array([[-10.0, 10.0], [-10.0, 10.0]])\n",
        "\n",
        "    def poblacion_inicial(n, rng):\n",
        "        lo, hi = BOUNDS[:, 0], BOUNDS[:, 1]\n",
        "        return rng.uniform(lo, hi, size=(n, 2))\n",
        "\n",
        "    def seleccion_torneo(pob, fit, k, rng):\n",
        "        idx = rng.integers(0, len(pob), size=k)\n",
        "        ganador = idx[np.argmax(fit[idx])]\n",
        "        return pob[ganador]\n",
        "\n",
        "    def cruce_aritmetico(p1, p2, rng):\n",
        "        beta = rng.random()\n",
        "        return beta * p1 + (1 - beta) * p2\n",
        "\n",
        "    def mutar(hijo, p_mut, sigma, rng):\n",
        "        if rng.random() < p_mut:\n",
        "            hijo = hijo + rng.normal(scale=sigma, size=2)\n",
        "        hijo = np.clip(hijo, BOUNDS[:, 0], BOUNDS[:, 1])\n",
        "        return hijo\n",
        "\n",
        "    def algoritmo_genetico(n_pob=30, n_gen=60, k_torneo=3, p_mut=0.25,\n",
        "                           sigma_mut=1.0, n_elite=2, seed=0):\n",
        "        rng = np.random.default_rng(seed)\n",
        "        pob = poblacion_inicial(n_pob, rng)\n",
        "        fit = -f(pob[:, 0], pob[:, 1])\n",
        "\n",
        "        mejor_hist = []       # mejor historico acumulado\n",
        "        mejor_gen_hist = []   # mejor de cada generacion individual\n",
        "        mejor_x, mejor_f = None, np.inf\n",
        "\n",
        "        for gen in range(n_gen):\n",
        "            orden = np.argsort(-fit)\n",
        "            pob, fit = pob[orden], fit[orden]\n",
        "\n",
        "            mejor_gen_hist.append(-fit[0])\n",
        "            if -fit[0] < mejor_f:\n",
        "                mejor_f = -fit[0]\n",
        "                mejor_x = pob[0].copy()\n",
        "            mejor_hist.append(mejor_f)\n",
        "\n",
        "            nueva_pob = [pob[i].copy() for i in range(n_elite)]\n",
        "            while len(nueva_pob) < n_pob:\n",
        "                p1 = seleccion_torneo(pob, fit, k_torneo, rng)\n",
        "                p2 = seleccion_torneo(pob, fit, k_torneo, rng)\n",
        "                hijo = cruce_aritmetico(p1, p2, rng)\n",
        "                hijo = mutar(hijo, p_mut, sigma_mut, rng)\n",
        "                nueva_pob.append(hijo)\n",
        "\n",
        "            pob = np.array(nueva_pob)\n",
        "            fit = -f(pob[:, 0], pob[:, 1])\n",
        "\n",
        "        return mejor_x, mejor_f, np.array(mejor_hist), pob, np.array(mejor_gen_hist)\n",
        "\n",
        "    # --- Comparacion con la misma semilla del script original (seed=0) ---\n",
        "    mx_e, mf_e, hist_e, pob_e, gen_hist_e = algoritmo_genetico(\n",
        "        n_pob=30, n_gen=60, k_torneo=3, p_mut=0.25,\n",
        "        sigma_mut=1.0, n_elite=2, seed=0)\n",
        "    mx_s, mf_s, hist_s, pob_s, gen_hist_s = algoritmo_genetico(\n",
        "        n_pob=30, n_gen=60, k_torneo=3, p_mut=0.25,\n",
        "        sigma_mut=1.0, n_elite=0, seed=0)\n",
        "\n",
        "    print(f\"Con elitismo (n_elite=2)  -> x* = {mx_e.round(4)} f(x*) = {mf_e:.4f}\")\n",
        "    print(f\"Sin elitismo (n_elite=0)  -> x* = {mx_s.round(4)} f(x*) = {mf_s:.4f}\")\n",
        "\n",
        "    # --- Grafica comparativa de convergencia ---\n",
        "    f_global = -3.2879983559811907\n",
        "    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(13, 5.5))\n",
        "\n",
        "    # Izquierda: mejor historico acumulado\n",
        "    ax1.plot(hist_e, color=\"darkgreen\", lw=2.2, label=\"Con elitismo (historico)\")\n",
        "    ax1.plot(hist_s, \"--\", color=\"firebrick\", lw=2.2, label=\"Sin elitismo (historico)\")\n",
        "    ax1.set_xlabel(\"Generacion\")\n",
        "    ax1.set_ylabel(\"Mejor f historico acumulado\")\n",
        "    ax1.legend()\n",
        "    ax1.grid(alpha=0.2)\n",
        "\n",
        "    # Derecha: mejor de cada generacion, sin memoria\n",
        "    ax2.plot(gen_hist_e, \"o-\", color=\"darkgreen\", lw=2, ms=4,\n",
        "             label=\"Con elitismo (por generacion)\")\n",
        "    ax2.plot(gen_hist_s, \"x-\", color=\"firebrick\", lw=2, ms=5,\n",
        "             label=\"Sin elitismo (por generacion)\")\n",
        "    ax2.axhline(f_global, color=\"gray\", ls=\":\", lw=1.5,\n",
        "                label=f\"Global f*={f_global:.4f}\")\n",
        "    ax2.set_xlabel(\"Generacion\")\n",
        "    ax2.set_ylabel(\"Mejor f de esa generacion (sin memoria)\")\n",
        "    ax2.legend()\n",
        "    ax2.grid(alpha=0.2)\n",
        "\n",
        "    fig.suptitle(\"Efecto del elitismo en la curva de convergencia del algoritmo genetico (seed=0)\")\n",
        "    fig.tight_layout()\n",
        "    fig.savefig(\"3-grafica-comparativa.jpg\", dpi=150, bbox_inches=\"tight\")\n",
        "    print(\"Figura guardada: 3-grafica-comparativa.jpg\")\n",
        "\n",
        "    # --- Verificacion: el mejor de cada generacion empeora sin elitismo? ---\n",
        "    print(\"Es la curva historica (mejor-hasta-ahora) siempre no creciente en ambos casos?\")\n",
        "    print(\"Con elitismo, no-creciente:\", np.all(np.diff(hist_e) <= 1e-12))\n",
        "    print(\"Sin elitismo, no-creciente:\", np.all(np.diff(hist_s) <= 1e-12))\n",
        "\n",
        "    print(\"\\nEl mejor DE LA GENERACION empeora de una gen a otra?\")\n",
        "    empeora_e = np.sum(np.diff(gen_hist_e) > 1e-9)\n",
        "    empeora_s = np.sum(np.diff(gen_hist_s) > 1e-9)\n",
        "    print(\"Con elitismo, veces que empeora el mejor-de-la-generacion:\", empeora_e, \"/\", len(gen_hist_e)-1)\n",
        "    print(\"Sin elitismo, veces que empeora el mejor-de-la-generacion:\", empeora_s, \"/\", len(gen_hist_s)-1)\n",
        "\n",
        "    # --- Comparacion de robustez con 10 semillas distintas ---\n",
        "    tol_exito = 0.01\n",
        "    seeds = list(range(10))\n",
        "\n",
        "    res_elite, res_sin = [], []\n",
        "    for seed in seeds:\n",
        "        _, mf_e, _, _, _ = algoritmo_genetico(n_pob=30, n_gen=60, k_torneo=3,\n",
        "                                              p_mut=0.25, sigma_mut=1.0, n_elite=2, seed=seed)\n",
        "        _, mf_s, _, _, _ = algoritmo_genetico(n_pob=30, n_gen=60, k_torneo=3,\n",
        "                                              p_mut=0.25, sigma_mut=1.0, n_elite=0, seed=seed)\n",
        "        res_elite.append(mf_e)\n",
        "        res_sin.append(mf_s)\n",
        "\n",
        "    res_elite = np.array(res_elite)\n",
        "    res_sin = np.array(res_sin)\n",
        "    exitos_elite = np.sum(np.abs(res_elite - f_global) < tol_exito)\n",
        "    exitos_sin = np.sum(np.abs(res_sin - f_global) < tol_exito)\n",
        "\n",
        "    header = (f\"{'Config':16} | {'Exitos/10':>9} | {'f promedio':>11} | \"\n",
        "              f\"{'f minimo':>10} | {'f maximo':>10}\")\n",
        "    print(header)\n",
        "    print(\"-\" * len(header))\n",
        "    print(f\"{'Con elitismo':16} | {exitos_elite:9d} | {res_elite.mean():11.4f} | \"\n",
        "          f\"{res_elite.min():10.4f} | {res_elite.max():10.4f}\")\n",
        "    print(f\"{'Sin elitismo':16} | {exitos_sin:9d} | {res_sin.mean():11.4f} | \"\n",
        "          f\"{res_sin.min():10.4f} | {res_sin.max():10.4f}\")\n",
        "\n",
