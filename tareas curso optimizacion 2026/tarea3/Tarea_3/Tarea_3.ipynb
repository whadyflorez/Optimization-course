        "# =====================================================================\n",
        "# EJERCICIO 4 - Inertia weight damping en PSO\n",
        "# =====================================================================\n",
        "def ejercicio_4():\n",
        "    import numpy as np\n",
        "\n",
        "    POZOS = [\n",
        "        (-5.0, -6.5, 4.0, 1.3),\n",
        "        (-4.0,  5.0, 4.0, 1.1),\n",
        "        (-3.0, -5.0, -4.0, 1.1),\n",
        "        (-2.0,  5.0, -5.0, 1.0),\n",
        "        (-1.8,  0.0, 6.0, 1.0),\n",
        "        (-1.5, -6.0, 0.0, 1.0),\n",
        "    ]\n",
        "\n",
        "    def f(x, y):\n",
        "        z = 0.03 * (x**2 + y**2)\n",
        "        for w, cx, cy, s in POZOS:\n",
        "            z += w * np.exp(-((x - cx)**2 + (y - cy)**2) / (2 * s**2))\n",
        "        return z\n",
        "\n",
        "    BOUNDS = np.array([[-10.0, 10.0], [-10.0, 10.0]])\n",
        "\n",
        "    def pso_manual(n_particulas=25, n_iter=60, w=0.7, c1=1.5, c2=1.5, seed=0):\n",
        "        rng = np.random.default_rng(seed)\n",
        "        lo, hi = BOUNDS[:, 0], BOUNDS[:, 1]\n",
        "        x = rng.uniform(lo, hi, size=(n_particulas, 2))\n",
        "        v = rng.uniform(-1, 1, size=(n_particulas, 2))\n",
        "        p_best = x.copy()\n",
        "        f_p_best = f(x[:, 0], x[:, 1])\n",
        "        ig = np.argmin(f_p_best)\n",
        "        g_best = p_best[ig].copy()\n",
        "        f_g_best = f_p_best[ig]\n",
        "        historia_gbest = [f_g_best]\n",
        "        for it in range(n_iter):\n",
        "            r1 = rng.random((n_particulas, 2))\n",
        "            r2 = rng.random((n_particulas, 2))\n",
        "            v = (w * v + c1 * r1 * (p_best - x) + c2 * r2 * (g_best - x))  # w FIJO\n",
        "            x = np.clip(x + v, lo, hi)\n",
        "            f_x = f(x[:, 0], x[:, 1])\n",
        "            mejora = f_x < f_p_best\n",
        "            p_best[mejora] = x[mejora]\n",
        "            f_p_best[mejora] = f_x[mejora]\n",
        "            ig = np.argmin(f_p_best)\n",
        "            if f_p_best[ig] < f_g_best:\n",
        "                f_g_best = f_p_best[ig]\n",
        "                g_best = p_best[ig].copy()\n",
        "            historia_gbest.append(f_g_best)\n",
        "        return g_best, f_g_best, np.array(historia_gbest)\n",
        "\n",
        "    def pso_manual_w_decreciente(n_particulas=25, n_iter=60, w_max=0.9, w_min=0.4,\n",
        "                                 c1=1.5, c2=1.5, seed=0):\n",
        "        rng = np.random.default_rng(seed)\n",
        "        lo, hi = BOUNDS[:, 0], BOUNDS[:, 1]\n",
        "        x = rng.uniform(lo, hi, size=(n_particulas, 2))\n",
        "        v = rng.uniform(-1, 1, size=(n_particulas, 2))\n",
        "        p_best = x.copy()\n",
        "        f_p_best = f(x[:, 0], x[:, 1])\n",
        "        ig = np.argmin(f_p_best)\n",
        "        g_best = p_best[ig].copy()\n",
        "        f_g_best = f_p_best[ig]\n",
        "        historia_gbest = [f_g_best]\n",
        "        w_historia = []\n",
        "        for it in range(n_iter):\n",
        "            w = w_max - (w_max - w_min) * (it / n_iter)   # INERTIA WEIGHT DAMPING\n",
        "            w_historia.append(w)\n",
        "            r1 = rng.random((n_particulas, 2))\n",
        "            r2 = rng.random((n_particulas, 2))\n",
        "            v = (w * v + c1 * r1 * (p_best - x) + c2 * r2 * (g_best - x))\n",
        "            x = np.clip(x + v, lo, hi)\n",
        "            f_x = f(x[:, 0], x[:, 1])\n",
        "            mejora = f_x < f_p_best\n",
        "            p_best[mejora] = x[mejora]\n",
        "            f_p_best[mejora] = f_x[mejora]\n",
        "            ig = np.argmin(f_p_best)\n",
        "            if f_p_best[ig] < f_g_best:\n",
        "                f_g_best = f_p_best[ig]\n",
        "                g_best = p_best[ig].copy()\n",
        "            historia_gbest.append(f_g_best)\n",
        "        return g_best, f_g_best, np.array(historia_gbest), np.array(w_historia)\n",
        "\n",
        "    # --- Comparacion con la misma semilla del script original (seed=0) ---\n",
        "    gb_fijo, fgb_fijo, hist_fijo = pso_manual(n_particulas=25, n_iter=60, w=0.7, c1=1.5, c2=1.5, seed=0)\n",
        "    gb_dec, fgb_dec, hist_dec, w_hist = pso_manual_w_decreciente(\n",
        "        n_particulas=25, n_iter=60, w_max=0.9, w_min=0.4, c1=1.5, c2=1.5, seed=0)\n",
        "\n",
        "    print(f\"w fijo (0.7)            -> x* = {gb_fijo.round(4)} f* = {fgb_fijo:.4f}\")\n",
        "    print(f\"w decreciente 0.9->0.4  -> x* = {gb_dec.round(4)} f* = {fgb_dec:.4f}\")\n",
        "\n",
        "    # --- Comparacion de robustez con 10 semillas distintas ---\n",
        "    f_global = -3.2879983559811907\n",
        "    tol_exito = 0.01\n",
        "    seeds = list(range(10))\n",
        "\n",
        "    res_fijo, res_dec = [], []\n",
        "    it_fijo_list, it_dec_list = [], []\n",
        "\n",
        "    for seed in seeds:\n",
        "        gb_f, fgb_f, hist_f = pso_manual(n_particulas=25, n_iter=60, w=0.7, c1=1.5, c2=1.5, seed=seed)\n",
        "        gb_d, fgb_d, hist_d, _ = pso_manual_w_decreciente(n_particulas=25, n_iter=60,\n",
        "                                                          w_max=0.9, w_min=0.4, c1=1.5, c2=1.5, seed=seed)\n",
        "        res_fijo.append(fgb_f)\n",
        "        res_dec.append(fgb_d)\n",
        "\n",
        "        idx_f = np.where(np.abs(hist_f - f_global) < tol_exito)[0]\n",
        "        idx_d = np.where(np.abs(hist_d - f_global) < tol_exito)[0]\n",
        "        it_fijo_list.append(idx_f[0] if len(idx_f) > 0 else np.nan)\n",
        "        it_dec_list.append(idx_d[0] if len(idx_d) > 0 else np.nan)\n",
        "\n",
        "    res_fijo = np.array(res_fijo)\n",
        "    res_dec = np.array(res_dec)\n",
        "    it_fijo_arr = np.array(it_fijo_list, dtype=float)\n",
        "    it_dec_arr = np.array(it_dec_list, dtype=float)\n",
        "\n",
        "    exitos_fijo = np.sum(np.abs(res_fijo - f_global) < tol_exito)\n",
        "    exitos_dec = np.sum(np.abs(res_dec - f_global) < tol_exito)\n",
        "\n",
        "    header = (f\"{'Config':20} | {'Exitos/10':>9} | {'f promedio':>11} | {'f minimo':>10} | \"\n",
        "              f\"{'f maximo':>10} | {'it prom. convergencia':>22}\")\n",
        "    print(header)\n",
        "    print(\"-\" * len(header))\n",
        "    print(f\"{'w fijo=0.7':20} | {exitos_fijo:9d} | {res_fijo.mean():11.4f} | {res_fijo.min():10.4f} | \"\n",
        "          f\"{res_fijo.max():10.4f} | {np.nanmean(it_fijo_arr):22.2f}\")\n",
        "    print(f\"{'w decrec 0.9->0.4':20} | {exitos_dec:9d} | {res_dec.mean():11.4f} | {res_dec.min():10.4f} | \"\n",
        "          f\"{res_dec.max():10.4f} | {np.nanmean(it_dec_arr):22.2f}\")\n",
        "\n",
        "    # --- Detalle por semilla ---\n",
        "    print(\"Valores f* con w fijo:       \", np.round(res_fijo, 4))\n",
        "    print(\"Valores f* con w decreciente:\", np.round(res_dec, 4))\n",
        "    print(\"Iteraciones de convergencia (w fijo):       \", it_fijo_arr)\n",
        "    print(\"Iteraciones de convergencia (w decreciente):\", it_dec_arr)\n",
        "\n",
        "\n",
        "# =====================================================================\n",
        "# EJERCICIO 5 - Comparacion final de los 4 metodos metaheuristicos\n",
        "# =====================================================================\n",
        "def ejercicio_5():\n",
        "    import numpy as np\n",
        "    from scipy.optimize import minimize\n",
        "\n",
        "    POZOS = [\n",
        "        (-5.0, -6.5, 4.0, 1.3), (-4.0, 5.0, 4.0, 1.1), (-3.0, -5.0, -4.0, 1.1),\n",
        "        (-2.0, 5.0, -5.0, 1.0), (-1.8, 0.0, 6.0, 1.0), (-1.5, -6.0, 0.0, 1.0),\n",
        "    ]\n",
        "\n",
        "    def f(x, y):\n",
        "        z = 0.03 * (x**2 + y**2)\n",
        "        for w, cx, cy, s in POZOS:\n",
        "            z += w * np.exp(-((x - cx)**2 + (y - cy)**2) / (2 * s**2))\n",
        "        return z\n",
        "\n",
        "    BOUNDS = np.array([[-10.0, 10.0], [-10.0, 10.0]])\n",
        "    x0 = np.array([8.0, -8.0])\n",
        "\n",
        "    def local_search_bfgs(x0):\n",
        "        res = minimize(lambda p: f(p[0], p[1]), x0, method=\"BFGS\")\n",
        "        return res.x, float(res.fun)\n",
        "\n",
        "    def basin_hopping_manual(x0, n_iter=40, step_size=7.0, T=1.5, seed=0):\n",
        "        rng = np.random.default_rng(seed)\n",
        "        x_cur, f_cur = local_search_bfgs(x0)\n",
        "        x_best, f_best = np.array(x_cur), f_cur\n",
        "        for it in range(n_iter):\n",
        "            x_prop = x_cur + rng.uniform(-step_size, step_size, size=2)\n",
        "            x_new, f_new = local_search_bfgs(x_prop)\n",
        "            aceptado = f_new < f_cur or rng.random() < np.exp(-(f_new - f_cur) / T)\n",
        "            if aceptado:\n",
        "                x_cur, f_cur = x_new, f_new\n",
        "                if f_new < f_best:\n",
        "                    x_best, f_best = np.array(x_new), f_new\n",
        "        return x_best, f_best\n",
        "\n",
        "    def simulated_annealing_manual(x0, T0=8.0, alpha=0.96, n_iter=200, paso=1.5, seed=0):\n",
        "        rng = np.random.default_rng(seed)\n",
        "        x_cur = np.array(x0, dtype=float); f_cur = float(f(*x_cur))\n",
        "        x_best, f_best = x_cur.copy(), f_cur\n",
        "        T = T0\n",
        "        for it in range(n_iter):\n",
        "            x_prop = x_cur + rng.normal(scale=paso, size=2)\n",
        "            f_prop = float(f(*x_prop))\n",
        "            dE = f_prop - f_cur\n",
        "            aceptado = dE < 0 or rng.random() < np.exp(-dE / T)\n",
        "            if aceptado:\n",
        "                x_cur, f_cur = x_prop, f_prop\n",
        "                if f_cur < f_best:\n",
        "                    x_best, f_best = x_cur.copy(), f_cur\n",
        "            T *= alpha\n",
        "        return x_best, f_best\n",
        "\n",
        "    def algoritmo_genetico(n_pob=30, n_gen=60, k_torneo=3, p_mut=0.25,\n",
        "                           sigma_mut=1.0, n_elite=2, seed=0):\n",
        "        rng = np.random.default_rng(seed)\n",
        "        lo, hi = BOUNDS[:, 0], BOUNDS[:, 1]\n",
        "        pob = rng.uniform(lo, hi, size=(n_pob, 2))\n",
        "        fit = -f(pob[:, 0], pob[:, 1])\n",
        "        mejor_x, mejor_f = None, np.inf\n",
        "        for gen in range(n_gen):\n",
        "            orden = np.argsort(-fit); pob, fit = pob[orden], fit[orden]\n",
        "            if -fit[0] < mejor_f:\n",
        "                mejor_f = -fit[0]; mejor_x = pob[0].copy()\n",
        "            nueva_pob = [pob[i].copy() for i in range(n_elite)]\n",
        "            while len(nueva_pob) < n_pob:\n",
        "                idx1 = rng.integers(0, len(pob), size=k_torneo); p1 = pob[idx1[np.argmax(fit[idx1])]]\n",
        "                idx2 = rng.integers(0, len(pob), size=k_torneo); p2 = pob[idx2[np.argmax(fit[idx2])]]\n",
        "                beta = rng.random(); hijo = beta * p1 + (1 - beta) * p2\n",
        "                if rng.random() < p_mut:\n",
        "                    hijo = hijo + rng.normal(scale=sigma_mut, size=2)\n",
        "                hijo = np.clip(hijo, lo, hi)\n",
        "                nueva_pob.append(hijo)\n",
        "            pob = np.array(nueva_pob); fit = -f(pob[:, 0], pob[:, 1])\n",
        "        return mejor_x, mejor_f\n",
        "\n",
        "    def pso_manual(n_particulas=25, n_iter=60, w=0.7, c1=1.5, c2=1.5, seed=0):\n",
        "        rng = np.random.default_rng(seed)\n",
        "        lo, hi = BOUNDS[:, 0], BOUNDS[:, 1]\n",
        "        x = rng.uniform(lo, hi, size=(n_particulas, 2))\n",
        "        v = rng.uniform(-1, 1, size=(n_particulas, 2))\n",
        "        p_best = x.copy(); f_p_best = f(x[:, 0], x[:, 1])\n",
        "        ig = np.argmin(f_p_best); g_best = p_best[ig].copy(); f_g_best = f_p_best[ig]\n",
        "        for it in range(n_iter):\n",
        "            r1 = rng.random((n_particulas, 2)); r2 = rng.random((n_particulas, 2))\n",
        "            v = w * v + c1 * r1 * (p_best - x) + c2 * r2 * (g_best - x)\n",
        "            x = np.clip(x + v, lo, hi)\n",
        "            f_x = f(x[:, 0], x[:, 1])\n",
        "            mejora = f_x < f_p_best\n",
        "            p_best[mejora] = x[mejora]; f_p_best[mejora] = f_x[mejora]\n",
        "            ig = np.argmin(f_p_best)\n",
        "            if f_p_best[ig] < f_g_best:\n",
        "                f_g_best = f_p_best[ig]; g_best = p_best[ig].copy()\n",
        "        return g_best, f_g_best\n",
        "\n",
        "    seeds = list(range(10))\n",
        "    res_bh, res_sa, res_ga, res_pso = [], [], [], []\n",
        "    for seed in seeds:\n",
        "        _, fb = basin_hopping_manual(x0, seed=seed); res_bh.append(fb)\n",
        "        _, fs = simulated_annealing_manual(x0, seed=seed); res_sa.append(fs)\n",
        "        _, fg = algoritmo_genetico(seed=seed); res_ga.append(fg)\n",
        "        _, fp = pso_manual(seed=seed); res_pso.append(fp)\n",
        "\n",
        "    res_bh, res_sa, res_ga, res_pso = map(np.array, [res_bh, res_sa, res_ga, res_pso])\n",
        "\n",
        "    # --- Resultados por semilla ---\n",
        "    print(\"Basin hopping:      \", np.round(res_bh, 4))\n",
        "    print(\"Simulated annealing: \", np.round(res_sa, 4))\n",
        "    print(\"Algoritmo genetico:  \", np.round(res_ga, 4))\n",
        "    print(\"PSO:                 \", np.round(res_pso, 4))\n",
        "\n",
        "    # --- Tabla resumen de consistencia ---\n",
        "    f_global = -3.2879983559811907\n",
        "    tol_exito = 0.01\n",
        "    metodos = {\"Basin hopping\": res_bh, \"Simulated annealing\": res_sa,\n",
        "               \"Algoritmo genetico\": res_ga, \"PSO\": res_pso}\n",
        "\n",
        "    header = (f\"{'Metodo':22} | {'Exitos/10':>9} | {'f promedio':>11} | {'f std':>8} | \"\n",
        "              f\"{'f minimo':>10} | {'f maximo':>10}\")\n",
        "    print(header)\n",
        "    print(\"-\" * len(header))\n",
        "    for nombre, vals in metodos.items():\n",
        "        exitos = np.sum(np.abs(vals - f_global) < tol_exito)\n",
        "        print(f\"{nombre:22} | {exitos:9d} | {vals.mean():11.4f} | {vals.std():8.4f} | \"\n",
        "              f\"{vals.min():10.4f} | {vals.max():10.4f}\")\n",
        "\n",
        "\n",
